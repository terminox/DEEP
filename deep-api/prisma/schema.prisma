// Deep backend schema.
// Covers four features: auth (users + rotating refresh sessions),
// onboarding (server-driven config + per-user profile), Deep Sound
// (categories -> collections -> tracks -> multi-language lyrics), and
// practice-session logging (completed guided-breathing sessions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TrackKind {
  INSTRUMENTAL
  GUIDED
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  displayName     String
  role            Role     @default(USER)
  // Last-seen IANA device timezone (from the X-Device-Timezone header),
  // persisted opportunistically; the day-key fallback when the header is absent.
  timezone        String?
  // The plant currently receiving sunlight; lazily assigned on first award.
  selectedPlantId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  selectedPlant Plant? @relation("SelectedPlant", fields: [selectedPlantId], references: [id], onDelete: SetNull)

  sessions         AuthSession[]
  onboarding       OnboardingProfile?
  practiceSessions PracticeSession[]
  peaceMessages    PeaceMessage[]
  reflections      PauseReflection[]
  plantProgress    UserPlantProgress[]
  awards           Award[]
  earnTallies      DailyEarnTally[]
  wallet           UserWallet?
  heartSpends      HeartSpend[]
  pauseAttendances PauseAttendance[]
  playlists        Playlist[]
  contentDrafts    ContentDraft[]

  @@map("users")
}

// DB-backed refresh sessions with rotation + reuse detection.
model AuthSession {
  id                   String    @id @default(uuid())
  userId               String
  refreshTokenHash     String    @unique
  prevRefreshTokenHash String?
  userAgent            String?
  ip                   String?
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// Per-user onboarding answers. quizAnswers is the flat questionId -> optionId
// map the iOS app already uses, kept as JSON so questions can be added or
// reordered without breaking older saved state.
model OnboardingProfile {
  userId      String    @id
  quizAnswers Json      @default("{}")
  mindTree    String?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
}

// ---- Onboarding config (server-driven; seeded from iOS fixtures) ----

model QuizQuestion {
  id           String       @id
  prompt       String
  displayOrder Int          @default(0)
  options      QuizOption[]

  @@map("quiz_questions")
}

model QuizOption {
  id           String  @id @default(uuid())
  questionId   String
  // Per-question stable id the client records as the answer value
  // (e.g. "slow-down"). Unique within a question, not globally.
  key          String
  title        String
  subtitle     String?
  palette      String
  displayOrder Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
  @@index([questionId])
  @@map("quiz_options")
}

// ---- Mind Garden plants (admin-managed catalog; was MindTree) ----

// One growable plant. Keeps the string slug PK ("oak" | admin slug
// /^[a-z0-9-]{2,32}$/) so onboarding answers and iOS ids carry over.
model Plant {
  id           String   @id
  name         String
  tagline      String
  // Picker card art; relative /media/... path or absolute URL.
  imageUrl     String?
  palette      String
  displayOrder Int      @default(0)
  // Premium plants are hidden from ALL user-facing endpoints until premium ships.
  isPremium    Boolean  @default(false)
  // Shown in onboarding (multiple allowed).
  isDefault    Boolean  @default(false)
  // Visible in the picker. Half-built plants no longer leak in because an
  // unpublished plant has no row at all - see ContentDraft.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stages       PlantStage[]
  userProgress UserPlantProgress[]
  selectedBy   User[]              @relation("SelectedPlant")

  @@map("plants")
}

// One growth stage. sunlightRequired is the CUMULATIVE sunlight needed to
// REACH the stage; the first stage (by displayOrder) must be 0.
model PlantStage {
  id               String  @id @default(uuid())
  plantId          String
  name             String
  displayOrder     Int     @default(0)
  sunlightRequired Int     @default(0)
  // Relative media paths (/media/garden/...); served absolute to clients.
  mascotPath       String?
  mascotBgPath     String?
  heroVideoPath    String?

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, displayOrder])
  @@map("plant_stages")
}

// Per-plant persistent sunlight: switching plants pauses/resumes, never resets.
model UserPlantProgress {
  userId   String
  plantId  String
  sunlight Int    @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict protects user progress; deleting a plant in use → 409 plant_in_use.
  plant Plant @relation(fields: [plantId], references: [id], onDelete: Restrict)

  @@id([userId, plantId])
  @@map("user_plant_progress")
}

// ---- Deep Sound content ----

model SoundCategory {
  id           String            @id @default(uuid())
  slug         String            @unique
  title        String
  displayOrder Int               @default(0)
  // Visible in the app. Publishing is what makes new content live; this is the
  // separate lever for pulling live content down without deleting it.
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  collections  SoundCollection[]

  @@map("sound_categories")
}

model SoundCollection {
  id           String   @id @default(uuid())
  categoryId   String
  title        String
  subtitle     String
  palette      String
  imageUrl     String?
  displayOrder Int      @default(0)
  isPremium    Boolean  @default(false)
  // See SoundCategory.isActive.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category SoundCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tracks   SoundTrack[]

  @@index([categoryId])
  @@map("sound_collections")
}

model SoundTrack {
  id              String    @id @default(uuid())
  collectionId    String
  title           String
  durationSeconds Int
  kind            TrackKind @default(INSTRUMENTAL)
  // Relative media path (e.g. /media/audio/xyz.mp3); served absolute to clients.
  audioPath       String?
  displayOrder    Int             @default(0)
  isPremium       Boolean         @default(false)
  // See SoundCategory.isActive.
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  collection    SoundCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  lyrics        TrackLyrics[]
  playlistItems PlaylistItem[]

  @@index([collectionId])
  @@map("sound_tracks")
}

model TrackLyrics {
  id           String   @id @default(uuid())
  trackId      String
  languageCode String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  track SoundTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, languageCode])
  @@index([trackId])
  @@map("track_lyrics")
}

// ---- Playlists (sounds a listener kept for later) ----

// A user's own list of tracks. Exactly one per user today, created lazily and
// marked `isDefault`; everything downstream is keyed by playlist id, so a second
// list is an addition rather than a migration. A partial unique index (added by
// hand in the migration, since Prisma cannot express it) keeps two concurrent
// saves from both creating the default.
model Playlist {
  id           String   @id @default(uuid())
  userId       String
  name         String
  isDefault    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId])
  @@map("playlists")
}

// One kept track. `createdAt` is also the sort key - most recently kept first -
// so there is no separate position column until hand-reordering exists.
model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  createdAt  DateTime @default(now())

  playlist Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    SoundTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, createdAt])
  @@map("playlist_items")
}

// ---- Practice-session logging ----

// One completed guided-breathing session, logged as-is; the client owns
// aggregate math (today/streaks) in the user's local calendar.
model PracticeSession {
  id              String   @id // client-generated UUID → idempotent sync
  userId          String
  title           String
  durationSeconds Int
  completedAt     DateTime
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("practice_sessions")
}

// ---- Hearts & sunlight rewards ----

enum AwardKind {
  SESSION_COMPLETED
  TRACK_COMPLETED
  PAUSE_ATTENDED
  PEACE_MESSAGE
  DAILY_CHECKIN
}

// Append-only award ledger; the unique constraint is the idempotency contract
// (retries and sync replays land on the same row and grant nothing twice).
model Award {
  id        String    @id @default(uuid())
  userId    String
  kind      AwardKind
  // User-local day the award counts against — or the Bangkok pauseDate for
  // pause-family kinds.
  dayKey    String
  // sessionId | trackId | "" — empty string, NOT null (null breaks the unique).
  sourceId  String    @default("")
  // Granted amounts, stored separately per kind (they may diverge later).
  hearts    Int
  sunlight  Int
  // The plant the sunlight was credited to (historical record; no FK on purpose
  // so the ledger survives plant deletion).
  plantId   String?
  timezone  String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, dayKey, sourceId])
  @@index([userId, createdAt])
  @@map("awards")
}

// Per-user-per-day earn counter: the 30-hearts/day cap lives here, and its row
// lock (SELECT ... FOR UPDATE) serializes a user's concurrent grants.
model DailyEarnTally {
  userId   String
  dayKey   String
  hearts   Int    @default(0)
  sunlight Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dayKey])
  @@map("daily_earn_tallies")
}

// Spendable hearts balance; lazily upserted on first award/spend.
model UserWallet {
  userId        String @id
  heartsBalance Int    @default(0)
  heartsEarned  Int    @default(0)
  heartsGiven   Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallets")
}

// One heart spend (send/donate). The id is CLIENT-generated so a retried
// request lands on the same row instead of double-spending.
model HeartSpend {
  id        String   @id
  userId    String
  amount    Int
  // Opaque client catalog strings (compassion category/project stay a fixture).
  category  String
  projectId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("heart_spends")
}

// ---- Global Pause (the nightly synchronized event) ----

enum PeaceMessageStatus {
  PUBLISHED
  HIDDEN
}

// Singleton (id = 1). Phase boundaries are wall-clock "HH:mm:ss" strings in
// `timezone`; the server resolves them into absolute instants per occurrence,
// so clients never do timezone math.
//
// There is deliberately no column for where the meditation ends: it is
// meditationStart + meditationDurationSeconds, and that duration is measured
// off meditationAudioPath itself (see lib/audioDuration.ts). One number, read
// from the file — a hand-set end time silently outlived the track it was cut
// for, and every client ended the session at the old length.
//
// lobbyDurationSeconds is measured the same way, off lobbyAudioPath. It is how
// long Fuku's nightly set runs from lobbyStart, and the client needs it in two
// places at once — the lounge and the home card that opens it — so that both
// light their ON AIR badge over exactly the same minutes.
model PauseConfig {
  id                        Int      @id @default(1)
  timezone                  String   @default("Asia/Bangkok")
  lobbyStart                String   @default("20:30:00")
  welcomeStart              String   @default("20:39:50")
  meditationStart           String   @default("20:40:00")
  windowEnd                 String   @default("21:00:00")
  lobbyAudioPath            String   @default("/media/audio/global-pause-lobby.mp3")
  lobbyDurationSeconds      Int      @default(262)
  meditationAudioPath       String   @default("/media/audio/global-pause.mp3")
  meditationDurationSeconds Int      @default(132)
  updatedAt                 DateTime @updatedAt

  @@map("pause_config")
}

model PauseWelcomeMessage {
  id           String  @id @default(uuid())
  text         String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  @@map("pause_welcome_messages")
}

model PauseIntentionOption {
  id           String  @id @default(uuid())
  key          String  @unique
  label        String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  @@map("pause_intention_options")
}

// Published on post; moderation flips to HIDDEN after the fact. Pre-moderation
// would leave the ten-minute feedback phase empty unless an admin were live
// every night at 20:50.
model PeaceMessage {
  id          String             @id @default(uuid())
  userId      String?
  displayName String
  countryISO  String?
  text        String
  // The word the member tagged the message with, keyed to a
  // `PauseIntentionOption`. Denormalised onto the message because it is shown
  // on the card in the feed, where the author may since have been unlinked.
  intention   String?
  status      PeaceMessageStatus @default(PUBLISHED)
  // Occurrence key: the Bangkok calendar date of the pause ("2026-07-23").
  pauseDate   String
  createdAt   DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pauseDate, status, createdAt])
  // The all-nights public feed: newest first, keyset-paged on (createdAt, id).
  @@index([status, createdAt, id])
  @@map("peace_messages")
}

// One row per user per night: the intention and mood chosen in the feedback
// phase. Upserted, so a change of heart overwrites rather than duplicates.
model PauseReflection {
  id        String   @id @default(uuid())
  userId    String
  pauseDate String
  intention String?
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pauseDate])
  @@map("pause_reflections")
}

// Durable "was present" record per user per night (live presence is
// in-memory); feeds the attended-through-meditation award eligibility.
model PauseAttendance {
  id          String   @id @default(uuid())
  userId      String
  pauseDate   String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  beats       Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pauseDate])
  @@map("pause_attendances")
}

// ---- Safe publish: staged content changes ----
//
// Admin content writes are recorded here instead of being applied. Live tables
// stay untouched until an admin explicitly publishes, so nothing an admin types
// reaches the app by accident. The admin panel reads live rows overlaid with
// these drafts; the app reads the live tables and needs no filter, because
// unpublished content has no live row at all.

enum DraftOp {
  CREATE
  UPDATE
  DELETE
}

enum DraftEntity {
  SOUND_CATEGORY
  SOUND_COLLECTION
  SOUND_TRACK
  TRACK_LYRICS
  PLANT
  PLANT_STAGE
  PAUSE_CONFIG
  PAUSE_WELCOME_MESSAGE
  PAUSE_INTENTION
}

// One row per staged entity: repeat edits coalesce into the same row by merging
// `patch`, so the review screen shows "this record changed", not a keystroke log.
model ContentDraft {
  id          String      @id @default(uuid())
  entity      DraftEntity
  // Live row id for UPDATE/DELETE; a pre-minted id for CREATE, so children can
  // reference a parent that does not exist yet.
  entityId    String
  op          DraftOp
  // Partial column patch. Null for DELETE.
  patch       Json?
  // The live row's updatedAt when the draft was first staged. Publish refuses if
  // the row moved underneath, rather than silently clobbering.
  baseVersion DateTime?
  // Denormalised so the review screen renders without joining nine tables.
  label       String
  // "<entity>:<id>" of the parent, for grouping in the UI and publish ordering.
  parentKey   String?
  authorId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([entity, entityId])
  @@index([parentKey])
  @@map("content_drafts")
}
