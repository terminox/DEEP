{
  "name": "deep-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deep backend — auth, onboarding, and Deep Sound content.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "geoip:update": "bash scripts/geoip-update.sh",
    "seed:assets": "bash scripts/copy-garden-assets.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "maxmind": "^5.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
