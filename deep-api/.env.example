# Deep API — copy to .env and adjust for your machine
DATABASE_URL="postgresql://deep:deep@localhost:5434/deep_dev?schema=public"

JWT_SECRET="change-me"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

HOST=0.0.0.0
PORT=8080
MEDIA_DIR="./media"

# Origin used for absolute audio/artwork URLs. Leave it UNSET for local dev —
# media URLs then follow whatever host the client reached us on, so the
# simulator (localhost), a physical iPhone (your Mac's .local name) and the
# admin SPA all work at once. Staging/pilot/prod MUST set it to their real
# origin; that is what stops a client-supplied Host header being trusted.
# PUBLIC_BASE_URL="https://api.deep.app"

ADMIN_BOOTSTRAP_EMAIL="admin@deep.local"
ADMIN_BOOTSTRAP_PASSWORD="deepadmin123"

# Dev only — enables Global Pause time travel (the /dev/pause/time-travel
# route used by scripts/pause-time-travel.sh).
# MUST stay unset anywhere real: it lets anyone move the pause clock.
ALLOW_TIME_OVERRIDE=true

# Optional — enables real IP geolocation for Global Pause participants (falls
# back to country-only presence when the mmdb file isn't present).
# GEOIP_DB_PATH="./geoip/GeoLite2-City.mmdb"

# Only needed to run `npm run geoip:update`; never read at request time.
# MAXMIND_LICENSE_KEY="your-maxmind-license-key"

# Dev only — enables POST /dev/premium, which turns a user's DEEP Premium on or
# off without a purchase (see DEVELOPMENT.md). MUST stay unset anywhere real.
ALLOW_DEV_ENTITLEMENT=true

# --- DEEP Premium (RevenueCat) — all optional ---
# The exact Authorization header value configured on the webhook in the
# RevenueCat dashboard (Integrations → Webhooks → Authorization header).
# Unset → POST /webhooks/revenuecat answers 503 not_configured.
# REVENUECAT_WEBHOOK_AUTH="Bearer some-long-random-string"
# RevenueCat secret API key (sk_…), for POST /me/entitlement/refresh and
# transfer reconciliation. Unset → refresh answers 503 not_configured.
# REVENUECAT_SECRET_API_KEY="sk_..."
# The entitlement identifier that means DEEP Premium (default deep_premium).
# REVENUECAT_ENTITLEMENT_ID="deep_premium"
# Apply SANDBOX webhook events (TestFlight purchases are sandbox). Ignored
# sandbox events are still recorded. Turn off at public launch.
# REVENUECAT_ACCEPT_SANDBOX=true
