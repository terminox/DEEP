<?xml version="1.0" encoding="utf-8"?>
<!--
  The DEEP mark, as the iOS app icon draws it: a white ring and dot.

  Measured from Deep/Deep/Assets.xcassets/AppIcon.appiconset/DEEP_logo.png and
  mapped so that icon's full 1024px square lands on the 72dp an adaptive icon
  shows (18dp in from each edge of the 108dp canvas, 0.0703dp per px):

    ring  centre (511.5, 501)px, radius 285px, stroke 11px
    dot   radius 40px

  The ring stroke is 2% of its diameter and the dot 13%, which are the logo's
  proportions. The centre sits 1% above the middle, as it does on iOS.

  Pure white on a transparent canvas. That is why ic_launcher.xml can hand this
  same drawable to the themed (monochrome) icon, which keeps only the alpha.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="0.77"
      android:fillColor="#00000000"
      android:pathData="M 54,33.19 A 20.04,20.04 0 1 1 53.99,33.19 Z" />

  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M 54,50.42 A 2.81,2.81 0 1 1 53.99,50.42 Z" />

</vector>
