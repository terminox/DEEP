<?xml version="1.0" encoding="utf-8"?>
<!--
  app_name is not here: each product flavor sets it through resValue in
  app/build.gradle.kts, so DEEP Dev and DEEP Staging can sit on one device and
  tell themselves apart.

  The Thai lives in values-th/strings.xml.
-->
<resources>

  <!-- Tab bar -->
  <string name="tab_home">Home</string>
  <string name="tab_sounds">Sounds</string>
  <string name="tab_garden">Garden</string>
  <string name="tab_compassion">Compassion</string>
  <string name="tab_you">You</string>

  <!-- Placeholder tabs, week 1. Each names what is coming rather than saying
       "coming soon", which reads as an apology. -->
  <string name="placeholder_sounds_title">Somewhere to land</string>
  <string name="placeholder_sounds_body">Collections of soundscapes, and a player that follows you across the app.</string>
  <string name="placeholder_compassion_title">Practice turned outward</string>
  <string name="placeholder_compassion_body">Time spent in DEEP earns hearts. Hearts are given to causes.</string>
  <string name="placeholder_you_title">Your space</string>
  <string name="placeholder_you_body">The sounds you have kept, and how DEEP is set up for you.</string>

  <!-- Home feed -->
  <!-- collapsibleHomeHeader(title:subtitle:) on GlobalPauseHomeView.swift -->
  <string name="home_header_title">Home</string>
  <string name="home_header_subtitle">Take a breath with the world today</string>
  <!-- GlobalPauseHomeView.swift's failed feed: "We couldn't gather today's content just now." -->
  <string name="home_failed">We couldn’t gather today’s content just now.</string>
  <string name="home_retry">Try again</string>
  <!-- DeepSessionEntryCard.swift: "Begin %@, a guided breathing session" -->
  <string name="home_session_card_a11y">Begin %1$s, a guided breathing session</string>
  <string name="home_explore_title">Explore</string>
  <!-- ExploreByContentSection.swift's tile: "Explore %@" -->
  <string name="home_explore_category">Explore %1$s</string>
  <!-- HomeSectionHeader.swift: "See all" -->
  <string name="home_see_all">See all</string>
  <!-- SoundCollection.kindLabel (FeatureCard.swift) — plain Strings on iOS, so not in the catalog -->
  <string name="home_kind_guided">Guided</string>
  <string name="home_kind_soundscape">Soundscape</string>
  <!-- FeatureCard.swift's second line: "\(kindLabel) · \(subtitle)" -->
  <string name="home_kind_subtitle">%1$s · %2$s</string>
  <!-- HomeTile.swift / FeatureCard.swift's play button: "Play %@" -->
  <string name="home_play_collection">Play %1$s</string>

  <!-- DEEP Session -->
  <string name="session_begin">Begin</string>
  <!-- DeepSessionIntroView's beginButton accessibilityLabel: "Begin %@, %lld minutes" -->
  <string name="session_begin_accessibility">Begin %1$s, %2$d minutes</string>
  <string name="session_minutes">MIN</string>
  <string name="session_pattern">%1$ds in · %2$ds out · %3$d rounds</string>
  <string name="session_length">Session length</string>
  <plurals name="session_length_minutes">
    <item quantity="one">%1$d minute</item>
    <item quantity="other">%1$d minutes</item>
  </plurals>
  <string name="session_settling_in">Settling in</string>
  <!-- VoiceOver's opening announcement: "Settling in. \(countdownSeconds)" -->
  <string name="session_settling_in_announcement">Settling in. %1$d</string>
  <string name="session_breathe_in">Breathe in</string>
  <string name="session_breathe_out">Breathe out</string>
  <string name="session_paused">Paused</string>
  <string name="session_take_your_time">Take your time</string>
  <string name="session_time_left_almost">Almost there</string>
  <string name="session_time_left_minute">About a minute left</string>
  <string name="session_time_left_minutes">About %1$d min left</string>
  <string name="session_ending">You’re here now</string>
  <string name="session_complete">Session complete</string>
  <string name="session_pause">Pause</string>
  <string name="session_resume">Resume</string>
  <string name="session_close">Close</string>
  <string name="session_leave">Leave</string>
  <string name="session_leave_confirm">Leave your session?</string>
  <string name="session_leave_confirm_body">Your breath will be here whenever you’re ready to return.</string>
  <string name="session_stay">Keep breathing</string>

  <!-- Loading -->
  <string name="loading_beat">Take a moment</string>

</resources>
