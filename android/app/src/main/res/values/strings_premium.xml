  <string name="paywall_one_moment">One moment</string>
  <string name="paywall_subscribe">Subscribe</string>
  <plurals name="paywall_start_trial">
    <item quantity="one">Start your %1$d day free</item>
    <item quantity="other">Start your %1$d days free</item>
  </plurals>
