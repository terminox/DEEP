  <string name="paywall_subscribe_hint">Subscribes to DEEP Premium</string>
  <string name="paywall_start_trial_hint">Starts your free trial of DEEP Premium</string>
  <string name="paywall_everything_open">Everything is open.</string>
  <string name="paywall_done">Done</string>
  <string name="paywall_not_now">Not right now</string>
