    <item quantity="other">Today is full, %1$d hearts earned</item>
  </plurals>
  <plurals name="compassion_summary_today">
    <item quantity="one">%1$d of %2$d heart earned today</item>
    <item quantity="other">%1$d of %2$d hearts earned today</item>
