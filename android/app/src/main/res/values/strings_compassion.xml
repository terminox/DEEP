<?xml version="1.0" encoding="utf-8"?>
<!--
  The Compassion portfolio: the tab, the donate sheet, the (parked) cause
  detail, and the static catalogue of causes, partners, projects and field
  reports. Ported from Deep/Deep/Features/CompassionPortfolio/ and its keys in
  Deep/Deep/Localizable.xcstrings. The Thai lives in values-th/strings_compassion.xml.

  The catalogue copy is keyed by the ids in :core:model's CompassionCatalog
  (dashes become underscores), so the figures and the words can never drift.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

  <!-- Home -->
  <string name="compassion_title">Compassion</string>
  <string name="compassion_subtitle">Turn practice into giving</string>

  <!-- Portfolio card: "MY HEARTS" -->
  <string name="compassion_my_hearts">MY HEARTS</string>
  <!-- "\(balance) to give" -->
  <string name="compassion_to_give">%1$s to give</string>
  <string name="compassion_all_given">All given away</string>
  <string name="compassion_no_hearts_yet">No hearts yet</string>
  <!-- iOS " given" — the figure is drawn before it -->
  <string name="compassion_given_suffix">" given"</string>
  <!-- iOS " of %lld today" — the figure is drawn before it -->
  <string name="compassion_today_suffix" tools:ignore="PluralsCandidate">" of %1$d today"</string>
  <string name="compassion_today_full">today is full</string>
  <plurals name="compassion_summary_can_give">
    <item quantity="one">%1$d heart to give</item>
    <item quantity="other">%1$d hearts to give</item>
  </plurals>
