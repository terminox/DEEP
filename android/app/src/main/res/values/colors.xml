<?xml version="1.0" encoding="utf-8"?>
<!--
  The only colours that exist as Android resources, because the platform needs
  them before Compose runs: the window background and the splash. Everything
  else lives in theme/DeepColor.kt. The launcher icon's colours are artwork
  sampled from the iOS icon, and live in drawable/ic_launcher_background.xml.

  These three duplicate values from DeepPalette, which the token rules forbid
  everywhere else. There is no way to hand a Compose Color to a window theme, so
  the duplication is structural. Keep them in step with theme/DeepColor.kt.
-->
<resources>
  <color name="moon_cream">#FBF7FF</color>
  <color name="lavender_mist">#B8A7E8</color>
  <color name="deep_plum">#3D3654</color>
</resources>
