  week 5 as values-th/strings_deepsound.xml.
-->
<resources>

  <!-- Home (DeepSoundHomeView.swift) -->
  <!-- "DEEP Sound" -->
  <string name="deepsound_title">DEEP Sound</string>
  <!-- "Breathe and listen" -->
  <string name="deepsound_subtitle">Breathe and listen</string>
  <!-- "We couldn't gather the sounds just now." -->
  <string name="deepsound_failed">We couldn\'t gather the sounds just now.</string>
  <!-- "Try again" -->
  <string name="deepsound_retry">Try again</string>

  <!-- Breathe hero card (BreatheHeroCard.swift) -->
  <!-- "DEEP SESSION" -->
  <string name="deepsound_breathe_eyebrow">DEEP SESSION</string>
  <!-- "Breathe" -->
  <string name="deepsound_breathe_title">Breathe</string>
  <!-- "%llds in · %llds out" -->
  <string name="deepsound_breathe_pattern">%1$ds in · %2$ds out</string>
  <!-- "Breathe, a guided breathing session" -->
  <string name="deepsound_breathe_a11y">Breathe, a guided breathing session</string>
