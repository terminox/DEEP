  <string name="deepsound_balancing_breath_title">Balancing breath</string>
  <!-- "Slow breathing to settle back into now" -->
  <string name="deepsound_balancing_breath_tagline">Slow breathing to settle back into now</string>

  <!-- Collection detail (CollectionDetailView.swift) -->
  <!-- "Back" -->
  <string name="deepsound_back">Back</string>
  <!-- "%lld tracks · %@" — the count and the length, joined -->
  <string name="deepsound_collection_meta">%1$s · %2$s</string>
  <plurals name="deepsound_track_count">
    <item quantity="one">%d track</item>
    <item quantity="other">%d tracks</item>
  </plurals>
  <!-- TimeInterval.minutesString: "\(minutes) min" -->
  <string name="deepsound_minutes">%d min</string>
  <!-- SoundActionButton titles — plain Strings on iOS, so not in the catalog -->
  <string name="deepsound_play">Play</string>
  <string name="deepsound_shuffle">Shuffle</string>
  <!-- "Save to playlist" / "Remove from playlist" -->
  <string name="deepsound_save_to_playlist">Save to playlist</string>
  <string name="deepsound_remove_from_playlist">Remove from playlist</string>

  <!-- Lyrics (LyricsSheet.swift) -->
  <!-- "No lyrics for this one — just let it wash over you." -->
  <string name="deepsound_lyrics_empty">No lyrics for this one — just let it wash over you.</string>

