// The App Store build: Prod, signed for distribution on the client's team.
//
// Everything about *what the app talks to* — APP_ENV, API_BASE_URL, APP_DISPLAY_NAME, the
// bundle id and the whole release optimisation profile — is inherited from Prod, unchanged.
// Only the version stamp and the way it is signed differ, because Prod itself stays
// runnable on a simulator and a development device with Automatic signing.
#include "Prod.xcconfig"

// ---- Version ----
// Never override APP_ENV here. AppConfig maps it through
// `AppEnvironment(rawValue:) ?? .dev`, so an unrecognised value would silently downgrade a
// shipping build to the dev environment.
MARKETING_VERSION = 1.0.0
// Unix epoch seconds, stamped by scripts/archive-app-store.sh — always ahead of the last
// upload, never repeats.
CURRENT_PROJECT_VERSION = 1794586575

// ---- Signing ----
// Manual signing with a profile minted through the App Store Connect API (no Apple ID is
// signed into Xcode on the release Mac, so Xcode can't manage one). No entitlements file:
// the app uses no capability that needs one.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = DEEP App Store
