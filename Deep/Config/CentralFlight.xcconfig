// Central Flight is a distribution vehicle, not an environment.
//
// Client builds ship under a reusable App ID ("A central place to distribute app to
// clients") so they can reach TestFlight without touching Deep's own App Store record.
// Everything about *what the app talks to* — APP_ENV, API_BASE_URL, APP_DISPLAY_NAME and
// the whole release optimisation profile — is inherited from Prod, unchanged. Only the
// identity it wears and the way it is signed differ.
#include "Prod.xcconfig"

// ---- App Store identity ----
// Never override APP_ENV here. AppConfig maps it through
// `AppEnvironment(rawValue:) ?? .dev`, so an unrecognised value would silently downgrade a
// shipping build to the dev environment.
PRODUCT_BUNDLE_IDENTIFIER = com.kanekohouse.centralflight
MARKETING_VERSION = 1.0.0
// Unix epoch seconds, stamped by scripts/archive-central-flight.sh — always ahead of the
// last upload, never repeats.
CURRENT_PROJECT_VERSION = 1787767241

// ---- Signing ----
// Manual signing requires a profile Xcode does not manage, so this one was minted through
// the App Store Connect API. Its name predates this file's split from Prod; it is just a
// label. The App ID carries no Sign in with Apple capability and no Swift code implements
// it, so client builds ship without an entitlements file — Prod keeps Automatic signing
// and Deep.entitlements from Base.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = Deep Prod App Store
CODE_SIGN_ENTITLEMENTS =
