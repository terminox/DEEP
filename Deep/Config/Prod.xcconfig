#include "Base.xcconfig"

// ---- Environment ----
APP_ENV = prod
// Production Cloud Run URL (deterministic: deep-api-<projectNumber>.<region>.run.app).
// Swap for a custom domain (e.g. api.deep.app) once one is attached.
API_BASE_URL = https:/$()/deep-api-157102552469.asia-southeast1.run.app
// Production keeps the plain bundle id (no suffix).
BUNDLE_ID_SUFFIX =
APP_DISPLAY_NAME = DEEP

// ---- Release build profile ----
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
MTL_ENABLE_DEBUG_INFO = NO
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_ACTIVE_COMPILATION_CONDITIONS = PROD $(inherited)
VALIDATE_PRODUCT = YES
