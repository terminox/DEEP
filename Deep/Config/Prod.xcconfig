#include "Base.xcconfig"

// ---- Environment ----
APP_ENV = prod
// Production Cloud Run URL (deterministic: deep-api-<projectNumber>.<region>.run.app).
// Swap for a custom domain (e.g. api.deep.app) once one is attached.
API_BASE_URL = https:/$()/deep-api-157102552469.asia-southeast1.run.app
// Production keeps the plain bundle id (no suffix).
BUNDLE_ID_SUFFIX =
APP_DISPLAY_NAME = DEEP

// ---- App Store identity ----
// Production ships under the reusable client-distribution App ID rather than the Deep id,
// so the base id + suffix scheme above applies to Dev/Staging/Pilot only.
PRODUCT_BUNDLE_IDENTIFIER = com.kanekohouse.centralflight
MARKETING_VERSION = 1.0.0
// Unix epoch seconds at archive time — always ahead of the last upload, never repeats.
CURRENT_PROJECT_VERSION = 1787686882

// ---- Signing ----
// Manual, against "Deep Prod App Store" — a non-Xcode-managed App Store profile, which is
// what manual signing requires. The App ID carries no Sign in with Apple capability and no
// Swift code implements it, so production ships without an entitlements file; Dev/Staging/
// Pilot keep Automatic + Deep.entitlements from Base.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = Deep Prod App Store
CODE_SIGN_ENTITLEMENTS =

// ---- Release build profile ----
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
MTL_ENABLE_DEBUG_INFO = NO
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_ACTIVE_COMPILATION_CONDITIONS = PROD $(inherited)
VALIDATE_PRODUCT = YES
